@page "/admin/activities"
@attribute [Authorize(Roles = AuthConstants.AdminRole)]
@rendermode InteractiveServer
@inject IActivityService ActivityService

<PageTitle>Activities</PageTitle>

<h1>Manage Activities</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass">@message</div>
}

<div class="page-actions mb-3">
    <button class="btn btn-primary" type="button" @onclick="OpenAddActivityDialog">Add activity</button>
</div>

@if (showActivityDialog)
{
    <div class="dialog-backdrop" @onclick="CloseActivityDialog">
        <section class="dialog-panel" role="dialog" aria-modal="true" aria-labelledby="activityDialogTitle" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <div>
                    <p class="eyebrow mb-1">Admin</p>
                    <h2 id="activityDialogTitle">@(IsEditing ? "Edit Activity" : "Add Activity")</h2>
                </div>
                <button class="dialog-close" type="button" @onclick="CloseActivityDialog" aria-label="Close dialog">x</button>
            </div>

            <EditForm Model="activity" OnValidSubmit="SaveActivity" class="dialog-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="activityName">Activity name</label>
                        <InputText id="activityName" class="form-control" @bind-Value="activity.ActivityName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="activityType">Activity type</label>
                        <InputText id="activityType" class="form-control" @bind-Value="activity.ActivityType" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="description">Description</label>
                        <InputText id="description" class="form-control" @bind-Value="activity.Description" />
                    </div>
                    <div class="col-12">
                        <label class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="activity.IsActive" />
                            <span class="form-check-label">Active</span>
                        </label>
                    </div>
                </div>

                <div class="dialog-actions">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseActivityDialog">Cancel</button>
                    <button class="btn btn-primary" type="submit">@(IsEditing ? "Save changes" : "Save activity")</button>
                </div>
            </EditForm>
        </section>
    </div>
}

<table class="table table-striped align-middle">
    <thead>
    <tr>
        <th>Activity</th>
        <th>Type</th>
        <th>Status</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in activities)
    {
        <tr>
            <td>@item.ActivityName</td>
            <td>@item.ActivityType</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary me-2" href="@($"/admin/activities/details/{item.Id}")">Details</a>
                <button class="btn btn-sm btn-outline-secondary me-2" type="button" @onclick="() => OpenEditActivityDialog(item.Id)">Edit</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => Deactivate(item.Id)" disabled="@(!item.IsActive)">Deactivate</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    private Activity activity = NewActivity();
    private List<Activity> activities = new();
    private bool showActivityDialog;
    private int? editingActivityId;
    private bool IsEditing => editingActivityId.HasValue;
    private string message = string.Empty;
    private string messageClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await LoadActivities();
    }

    private async Task SaveActivity()
    {
        if (IsEditing)
        {
            await ActivityService.UpdateActivityAsync(activity);
            message = "Activity updated.";
        }
        else
        {
            await ActivityService.AddActivityAsync(activity);
            message = "Activity saved.";
        }

        messageClass = "alert-success";
        CloseActivityDialog();
        await LoadActivities();
    }

    private void OpenAddActivityDialog()
    {
        ResetActivityForm();
        message = string.Empty;
        showActivityDialog = true;
    }

    private async Task OpenEditActivityDialog(int id)
    {
        var existingActivity = await ActivityService.GetActivityByIdAsync(id);
        if (existingActivity is null)
        {
            message = "Activity not found.";
            messageClass = "alert-danger";
            return;
        }

        editingActivityId = id;
        activity = new Activity
        {
            Id = existingActivity.Id,
            ActivityName = existingActivity.ActivityName,
            ActivityType = existingActivity.ActivityType,
            Description = existingActivity.Description,
            IsActive = existingActivity.IsActive
        };
        message = string.Empty;
        showActivityDialog = true;
    }

    private void CloseActivityDialog()
    {
        showActivityDialog = false;
        ResetActivityForm();
    }

    private void ResetActivityForm()
    {
        activity = NewActivity();
        editingActivityId = null;
    }

    private async Task Deactivate(int id)
    {
        await ActivityService.DeactivateActivityAsync(id);
        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        activities = await ActivityService.GetActivitiesAsync();
    }

    private static Activity NewActivity()
    {
        return new Activity { IsActive = true };
    }
}
