@page "/events"
@rendermode InteractiveServer
@inject IEventService EventService

<PageTitle>Upcoming Events</PageTitle>

<section class="events-hero">
    <div>
        <p class="eyebrow">Community programme</p>
        <h1>Upcoming Events</h1>
        <p class="lead">Find local activities, workshops, and volunteering opportunities open for registration.</p>
    </div>
    <div class="events-hero-stat">
        <strong>@(events?.Count ?? 0)</strong>
        <span>events listed</span>
    </div>
</section>

<section class="event-filter-panel">
    <div>
        <label class="form-label" for="eventDate">Date</label>
        <InputDate id="eventDate" class="form-control" @bind-Value="filterDate" />
    </div>
    <div>
        <label class="form-label" for="venueName">Venue</label>
        <InputText id="venueName" class="form-control" @bind-Value="venueName" placeholder="Search venue" />
    </div>
    <div>
        <label class="form-label" for="activityType">Activity type</label>
        <InputText id="activityType" class="form-control" @bind-Value="activityType" placeholder="Education, volunteering..." />
    </div>
    <div class="event-filter-actions">
        <button class="btn btn-primary" @onclick="ApplyFilters">Filter</button>
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
    </div>
</section>

@if (events is null)
{
    <div class="event-empty-state">Loading events...</div>
}
else if (events.Count == 0)
{
    <div class="event-empty-state">No upcoming events found. Try clearing the filters.</div>
}
else
{
    <div class="event-showcase-grid">
        @foreach (var eventItem in events)
        {
            <article class="event-showcase-card">
                <div class="event-card-topline">
                    <div class="event-date-badge">
                        <strong>@eventItem.EventDate.ToString("dd")</strong>
                        <span>@eventItem.EventDate.ToString("MMM")</span>
                    </div>
                    <span class="event-status-pill">@GetCapacityText(eventItem)</span>
                </div>

                <div class="event-card-body">
                    <h2>@eventItem.EventName</h2>
                    <p>@eventItem.Description</p>
                </div>

                <div class="event-meta-grid">
                    <div>
                        <span>Time</span>
                        <strong>@eventItem.StartTime.ToString(@"hh\:mm") - @eventItem.EndTime.ToString(@"hh\:mm")</strong>
                    </div>
                    <div>
                        <span>Venue</span>
                        <strong>@GetVenueList(eventItem)</strong>
                    </div>
                </div>

                <div class="event-chip-row">
                    @foreach (var activity in GetActivities(eventItem).Take(3))
                    {
                        <span>@activity</span>
                    }
                </div>

                <div class="event-capacity">
                    <div>
                        <span>Capacity</span>
                        <strong>@GetRegistrationCount(eventItem) / @eventItem.MaxParticipants</strong>
                    </div>
                    <div class="event-capacity-bar">
                        <span style="width: @GetCapacityPercent(eventItem)%"></span>
                    </div>
                </div>

                <a class="btn btn-primary w-100" href="@($"/events/details/{eventItem.Id}")">View details</a>
            </article>
        }
    </div>
}

@code {
    private List<Event>? events;
    private DateTime? filterDate;
    private string venueName = string.Empty;
    private string activityType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        events = await EventService.GetUpcomingEventsAsync();
    }

    private async Task ApplyFilters()
    {
        if (!string.IsNullOrWhiteSpace(activityType))
        {
            events = await EventService.GetEventsByActivityTypeAsync(activityType);
            return;
        }

        if (!string.IsNullOrWhiteSpace(venueName))
        {
            events = await EventService.GetEventsAsync(venueName);
            return;
        }

        if (filterDate.HasValue)
        {
            events = await EventService.GetEventsAsync(filterDate.Value);
            return;
        }

        events = await EventService.GetUpcomingEventsAsync();
    }

    private async Task ClearFilters()
    {
        filterDate = null;
        venueName = string.Empty;
        activityType = string.Empty;
        events = await EventService.GetUpcomingEventsAsync();
    }

    private static int GetRegistrationCount(Event eventItem)
    {
        return eventItem.Registrations.Count(registration => registration.Status != RegistrationStatus.Cancelled);
    }

    private static int GetCapacityPercent(Event eventItem)
    {
        if (eventItem.MaxParticipants <= 0)
        {
            return 0;
        }

        return Math.Min(100, GetRegistrationCount(eventItem) * 100 / eventItem.MaxParticipants);
    }

    private static string GetCapacityText(Event eventItem)
    {
        return GetRegistrationCount(eventItem) >= eventItem.MaxParticipants ? "Full" : "Open";
    }

    private static string GetVenueList(Event eventItem)
    {
        var venues = eventItem.EventVenues
            .Where(eventVenue => eventVenue.Venue is not null)
            .Select(eventVenue => eventVenue.Venue!.VenueName)
            .ToList();

        return venues.Count == 0 ? "To be confirmed" : string.Join(", ", venues);
    }

    private static List<string> GetActivities(Event eventItem)
    {
        return eventItem.EventActivities
            .Where(eventActivity => eventActivity.Activity is not null)
            .Select(eventActivity => eventActivity.Activity!.ActivityName)
            .ToList();
    }
}
