@page "/admin/events/edit/{Id:int}"
@attribute [Authorize(Roles = AuthConstants.AdminRole)]
@rendermode InteractiveServer
@inject IEventService EventService
@inject IVenueService VenueService
@inject IActivityService ActivityService
@inject NavigationManager NavigationManager

<PageTitle>Edit Event</PageTitle>

<h1>Edit Event</h1>

@if (eventModel is null)
{
    <div class="alert alert-warning">Event not found.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-danger">@message</div>
    }

    <EditForm Model="eventModel" OnValidSubmit="SaveEvent" class="card">
        <DataAnnotationsValidator />
        <div class="card-body">
            <ValidationSummary />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="eventName">Event name</label>
                    <InputText id="eventName" class="form-control" @bind-Value="eventModel.EventName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="eventDate">Date</label>
                    <InputDate id="eventDate" class="form-control" @bind-Value="eventModel.EventDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="maxParticipants">Max participants</label>
                    <InputNumber id="maxParticipants" class="form-control" @bind-Value="eventModel.MaxParticipants" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="startTime">Start time</label>
                    <InputText id="startTime" class="form-control" @bind-Value="startTimeText" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="endTime">End time</label>
                    <InputText id="endTime" class="form-control" @bind-Value="endTimeText" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="venue">Venue</label>
                    <select id="venue" class="form-select" ="selectedVenueId">
                        <option value="0">Choose venue</option>
                         (var venue in venues.Where(venue => venue.IsAvailable || venue.Id == selectedVenueId))
                        {
                            <option value=".Id">.VenueName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="activity">Activity</label>
                    <select id="activity" class="form-select" ="selectedActivityId">
                        <option value="0">Choose activity</option>
                         (var activity in activities.Where(activity => activity.IsActive || activity.Id == selectedActivityId))
                        {
                            <option value=".Id">.ActivityName</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label" for="description">Description</label>
                    <InputTextArea id="description" class="form-control" @bind-Value="eventModel.Description" />
                </div>
            </div>
        </div>
        <div class="card-footer bg-white">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-outline-secondary ms-2" href="/admin/events">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Event? eventModel;
    private string startTimeText = "09:00";
    private string endTimeText = "10:00";
    private string message = string.Empty;
    private List<Venue> venues = new();
    private List<Activity> activities = new();
    private int selectedVenueId;
    private int selectedActivityId;

    protected override async Task OnInitializedAsync()
    {
        eventModel = await EventService.GetEventByIdAsync(Id);
        venues = await VenueService.GetVenuesAsync();
        activities = await ActivityService.GetActivitiesAsync();

        if (eventModel is not null)
        {
            startTimeText = eventModel.StartTime.ToString(@"hh\:mm");
            endTimeText = eventModel.EndTime.ToString(@"hh\:mm");
            selectedVenueId = eventModel.EventVenues.FirstOrDefault()?.VenueId ?? 0;
            selectedActivityId = eventModel.EventActivities.FirstOrDefault()?.ActivityId ?? 0;
        }
    }

    private async Task SaveEvent()
    {
        if (eventModel is null)
        {
            return;
        }

        try
        {
            eventModel.StartTime = TimeSpan.Parse(startTimeText);
            eventModel.EndTime = TimeSpan.Parse(endTimeText);
            var venueIds = selectedVenueId > 0 ? new[] { selectedVenueId } : Array.Empty<int>();
            var activityIds = selectedActivityId > 0 ? new[] { selectedActivityId } : Array.Empty<int>();
            await EventService.UpdateEventAsync(eventModel, venueIds, activityIds);
            NavigationManager.NavigateTo("/admin/events");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }
}
