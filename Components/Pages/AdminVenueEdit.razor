@page "/admin/venues/edit/{Id:int}"
@attribute [Authorize(Roles = AuthConstants.AdminRole)]
@rendermode InteractiveServer
@inject IVenueService VenueService
@inject NavigationManager NavigationManager

<PageTitle>Edit Venue</PageTitle>

<h1>Edit Venue</h1>

@if (venue is null)
{
    <div class="alert alert-warning">Venue not found.</div>
}
else
{
    <EditForm Model="venue" OnValidSubmit="Save" class="card">
        <DataAnnotationsValidator />
        <div class="card-body">
            <ValidationSummary />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="venueName">Venue name</label>
                    <InputText id="venueName" class="form-control" @bind-Value="venue.VenueName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="address">Address</label>
                    <InputText id="address" class="form-control" @bind-Value="venue.Address" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="capacity">Capacity</label>
                    <InputNumber id="capacity" class="form-control" @bind-Value="venue.Capacity" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="description">Description</label>
                    <InputTextArea id="description" class="form-control" @bind-Value="venue.Description" />
                </div>
            </div>
        </div>
        <div class="card-footer bg-white">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-outline-secondary ms-2" href="/admin/venues">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Venue? venue;

    protected override async Task OnInitializedAsync()
    {
        venue = await VenueService.GetVenueByIdAsync(Id);
    }

    private async Task Save()
    {
        if (venue is null)
        {
            return;
        }

        await VenueService.UpdateVenueAsync(venue);
        NavigationManager.NavigateTo("/admin/venues");
    }
}
