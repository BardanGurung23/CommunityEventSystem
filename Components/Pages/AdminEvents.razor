@page "/admin/events"
@attribute [Authorize(Roles = AuthConstants.AdminRole)]
@rendermode InteractiveServer
@inject IEventService EventService
@inject IVenueService VenueService
@inject IActivityService ActivityService

<PageTitle>Events</PageTitle>

<h1>Manage Events</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass">@message</div>
}

<div class="page-actions mb-3">
    <button class="btn btn-primary" type="button" @onclick="OpenAddEventDialog">Add event</button>
</div>

@if (showEventDialog)
{
    <div class="dialog-backdrop" @onclick="CloseEventDialog">
        <section class="dialog-panel event-dialog" role="dialog" aria-modal="true" aria-labelledby="eventDialogTitle" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <div>
                    <p class="eyebrow mb-1">Admin</p>
                    <h2 id="eventDialogTitle">@(IsEditing ? "Edit Event" : "Add Event")</h2>
                </div>
                <button class="dialog-close" type="button" @onclick="CloseEventDialog" aria-label="Close dialog">x</button>
            </div>

            <EditForm Model="eventModel" OnValidSubmit="SaveEvent" class="dialog-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="eventName">Event name</label>
                        <InputText id="eventName" class="form-control" @bind-Value="eventModel.EventName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="eventDate">Date</label>
                        <InputDate id="eventDate" class="form-control" @bind-Value="eventModel.EventDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="maxParticipants">Max participants</label>
                        <InputNumber id="maxParticipants" class="form-control" @bind-Value="eventModel.MaxParticipants" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="startTime">Start time</label>
                        <InputText id="startTime" class="form-control" @bind-Value="startTimeText" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="endTime">End time</label>
                        <InputText id="endTime" class="form-control" @bind-Value="endTimeText" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="venue">Venue</label>
                        <select id="venue" class="form-select" @bind="selectedVenueId">
                            <option value="0">Choose venue</option>
                            @foreach (var venue in venues.Where(venue => venue.IsAvailable || venue.Id == selectedVenueId))
                            {
                                <option value="@venue.Id">@venue.VenueName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="activity">Activity</label>
                        <select id="activity" class="form-select" @bind="selectedActivityId">
                            <option value="0">Choose activity</option>
                            @foreach (var activity in activities.Where(activity => activity.IsActive || activity.Id == selectedActivityId))
                            {
                                <option value="@activity.Id">@activity.ActivityName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="eventDescription">Description</label>
                        <InputTextArea id="eventDescription" class="form-control" @bind-Value="eventModel.Description" />
                    </div>
                </div>

                <div class="dialog-actions">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseEventDialog">Cancel</button>
                    <button class="btn btn-primary" type="submit">@(IsEditing ? "Save changes" : "Save event")</button>
                </div>
            </EditForm>
        </section>
    </div>
}

<table class="table table-striped align-middle">
    <thead>
    <tr>
        <th>Event</th>
        <th>Date</th>
        <th>Venue</th>
        <th>Activities</th>
        <th>Status</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in events)
    {
        <tr>
            <td>@item.EventName</td>
            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
            <td>@GetVenueList(item)</td>
            <td>@GetActivityList(item)</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary me-2" href="@($"/admin/events/details/{item.Id}")">Details</a>
                <button class="btn btn-sm btn-outline-secondary me-2" type="button" @onclick="() => OpenEditEventDialog(item.Id)">Edit</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => Deactivate(item.Id)" disabled="@(!item.IsActive)">Deactivate</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    private Event eventModel = NewEvent();
    private List<Event> events = new();
    private List<Venue> venues = new();
    private List<Activity> activities = new();
    private int selectedVenueId;
    private int selectedActivityId;
    private string startTimeText = "09:00";
    private string endTimeText = "10:00";
    private string message = string.Empty;
    private string messageClass = "alert-success";
    private bool showEventDialog;
    private int? editingEventId;
    private bool IsEditing => editingEventId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task SaveEvent()
    {
        try
        {
            eventModel.StartTime = TimeSpan.Parse(startTimeText);
            eventModel.EndTime = TimeSpan.Parse(endTimeText);

            var venueIds = selectedVenueId > 0 ? new[] { selectedVenueId } : Array.Empty<int>();
            var activityIds = selectedActivityId > 0 ? new[] { selectedActivityId } : Array.Empty<int>();

            if (IsEditing)
            {
                await EventService.UpdateEventAsync(eventModel, venueIds, activityIds);
                message = "Event updated.";
            }
            else
            {
                await EventService.AddEventAsync(eventModel, venueIds, activityIds);
                message = "Event saved.";
            }

            ResetEventForm();
            messageClass = "alert-success";
            showEventDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageClass = "alert-danger";
        }
    }

    private async Task Deactivate(int id)
    {
        await EventService.DeactivateEventAsync(id);
        await LoadData();
    }

    private void OpenAddEventDialog()
    {
        ResetEventForm();
        message = string.Empty;
        showEventDialog = true;
    }

    private async Task OpenEditEventDialog(int id)
    {
        var existingEvent = await EventService.GetEventByIdAsync(id);
        if (existingEvent is null)
        {
            message = "Event not found.";
            messageClass = "alert-danger";
            return;
        }

        editingEventId = id;
        eventModel = new Event
        {
            Id = existingEvent.Id,
            EventName = existingEvent.EventName,
            EventDate = existingEvent.EventDate,
            StartTime = existingEvent.StartTime,
            EndTime = existingEvent.EndTime,
            Description = existingEvent.Description,
            MaxParticipants = existingEvent.MaxParticipants,
            CreatedAt = existingEvent.CreatedAt,
            UpdatedAt = existingEvent.UpdatedAt,
            IsActive = existingEvent.IsActive
        };
        selectedVenueId = existingEvent.EventVenues.FirstOrDefault()?.VenueId ?? 0;
        selectedActivityId = existingEvent.EventActivities.FirstOrDefault()?.ActivityId ?? 0;
        startTimeText = existingEvent.StartTime.ToString(@"hh\:mm");
        endTimeText = existingEvent.EndTime.ToString(@"hh\:mm");
        message = string.Empty;
        showEventDialog = true;
    }

    private void CloseEventDialog()
    {
        showEventDialog = false;
        ResetEventForm();
    }

    private void ResetEventForm()
    {
        eventModel = NewEvent();
        editingEventId = null;
        selectedVenueId = 0;
        selectedActivityId = 0;
        startTimeText = "09:00";
        endTimeText = "10:00";
    }

    private async Task LoadData()
    {
        events = await EventService.GetEventsAsync();
        venues = await VenueService.GetVenuesAsync();
        activities = await ActivityService.GetActivitiesAsync();
    }

    private static Event NewEvent()
    {
        return new Event
        {
            EventDate = DateTime.Today.AddDays(1),
            StartTime = TimeSpan.FromHours(9),
            EndTime = TimeSpan.FromHours(10),
            MaxParticipants = 1,
            IsActive = true
        };
    }

    private static string GetVenueList(Event item)
    {
        var names = item.EventVenues
            .Where(eventVenue => eventVenue.Venue is not null)
            .Select(eventVenue => eventVenue.Venue!.VenueName)
            .ToList();

        return names.Count == 0 ? "Not assigned" : string.Join(", ", names);
    }

    private static string GetActivityList(Event item)
    {
        var names = item.EventActivities
            .Where(eventActivity => eventActivity.Activity is not null)
            .Select(eventActivity => eventActivity.Activity!.ActivityName)
            .ToList();

        return names.Count == 0 ? "Not assigned" : string.Join(", ", names);
    }
}
