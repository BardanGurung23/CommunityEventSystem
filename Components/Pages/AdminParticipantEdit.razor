@page "/admin/participants/edit/{Id:int}"
@attribute [Authorize(Roles = AuthConstants.AdminRole)]
@rendermode InteractiveServer
@inject IParticipantService ParticipantService
@inject NavigationManager NavigationManager

<PageTitle>Edit Participant</PageTitle>

<h1>Edit Participant</h1>

@if (participant is null)
{
    <div class="alert alert-warning">Participant not found.</div>
}
else
{
    <EditForm Model="participant" OnValidSubmit="Save" class="card">
        <DataAnnotationsValidator />
        <div class="card-body">
            <ValidationSummary />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="fullName">Full name</label>
                    <InputText id="fullName" class="form-control" @bind-Value="participant.FullName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="email">Email</label>
                    <InputText id="email" class="form-control" @bind-Value="participant.Email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="phone">Phone</label>
                    <InputText id="phone" class="form-control" @bind-Value="participant.PhoneNumber" />
                </div>
            </div>
        </div>
        <div class="card-footer bg-white">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-outline-secondary ms-2" href="/admin/participants">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Participant? participant;

    protected override async Task OnInitializedAsync()
    {
        participant = await ParticipantService.GetParticipantByIdAsync(Id);
    }

    private async Task Save()
    {
        if (participant is null)
        {
            return;
        }

        await ParticipantService.UpdateParticipantAsync(participant);
        NavigationManager.NavigateTo("/admin/participants");
    }
}
