@page "/events/details/{Id:int}"
@rendermode InteractiveServer
@inject IEventService EventService
@inject IParticipantService ParticipantService
@inject IRegistrationService RegistrationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Event Details</PageTitle>

@if (eventItem is null)
{
    <div class="alert alert-warning">Event not found.</div>
}
else
{
    <h1>@eventItem.EventName</h1>
    <p class="lead">@eventItem.Description</p>

    <dl class="row">
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@eventItem.EventDate.ToString("dd MMM yyyy")</dd>
        <dt class="col-sm-3">Time</dt>
        <dd class="col-sm-9">@eventItem.StartTime.ToString(@"hh\:mm") - @eventItem.EndTime.ToString(@"hh\:mm")</dd>
        <dt class="col-sm-3">Venues</dt>
        <dd class="col-sm-9">@GetVenueList()</dd>
        <dt class="col-sm-3">Activities</dt>
        <dd class="col-sm-9">@GetActivityList()</dd>
    </dl>

    <div class="card">
        <div class="card-body">
            <h2 class="h5">Register for this event</h2>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert @messageClass">@message</div>
            }
            <AuthorizeView Roles="Participant">
                <Authorized>
                    <button class="btn btn-primary" @onclick="Register">Register me</button>
                    <a class="btn btn-outline-secondary ms-2" href="/my-registrations">My registrations</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary" href="/account/login">Login to register</a>
                    <a class="btn btn-outline-secondary ms-2" href="/account/register">Create participant account</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Event? eventItem;
    private int participantId;
    private string message = string.Empty;
    private string messageClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        eventItem = await EventService.GetEventByIdAsync(Id);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var participantClaim = authState.User.FindFirst(AuthConstants.ParticipantIdClaim)?.Value;
        int.TryParse(participantClaim, out participantId);
    }

    private async Task Register()
    {
        if (participantId <= 0)
        {
            message = "Login as a participant before registering.";
            messageClass = "alert-warning";
            return;
        }

        try
        {
            await RegistrationService.RegisterParticipantAsync(participantId, Id);
            eventItem = await EventService.GetEventByIdAsync(Id);
            message = "Registration submitted.";
            messageClass = "alert-success";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageClass = "alert-danger";
        }
    }

    private string GetVenueList()
    {
        var venues = eventItem?.EventVenues
            .Where(eventVenue => eventVenue.Venue is not null)
            .Select(eventVenue => eventVenue.Venue!.VenueName)
            .ToList() ?? new List<string>();

        return venues.Count == 0 ? "To be confirmed" : string.Join(", ", venues);
    }

    private string GetActivityList()
    {
        var activities = eventItem?.EventActivities
            .Where(eventActivity => eventActivity.Activity is not null)
            .Select(eventActivity => eventActivity.Activity!.ActivityName)
            .ToList() ?? new List<string>();

        return activities.Count == 0 ? "No activities assigned" : string.Join(", ", activities);
    }
}
