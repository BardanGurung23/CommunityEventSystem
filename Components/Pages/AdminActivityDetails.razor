@page "/admin/activities/details/{Id:int}"
@attribute [Authorize(Roles = AuthConstants.AdminRole)]
@inject IActivityService ActivityService

<PageTitle>Activity Details</PageTitle>

@if (activity is null)
{
    <div class="alert alert-warning">Activity not found.</div>
}
else
{
    <h1>@activity.ActivityName</h1>
    <dl class="row">
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@activity.ActivityType</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(activity.IsActive ? "Active" : "Inactive")</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@activity.Description</dd>
    </dl>

    <h2 class="h5">Assigned events</h2>
    @if (activity.EventActivities.Count == 0)
    {
        <div class="alert alert-info">No assigned events.</div>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var eventActivity in activity.EventActivities)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@eventActivity.Event?.EventName</span>
                    <span>@eventActivity.Event?.EventDate.ToString("dd MMM yyyy")</span>
                </li>
            }
        </ul>
    }

    <a class="btn btn-primary" href="@($"/admin/activities/edit/{activity.Id}")">Edit</a>
    <a class="btn btn-outline-secondary ms-2" href="/admin/activities">Back</a>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Activity? activity;

    protected override async Task OnInitializedAsync()
    {
        activity = await ActivityService.GetActivityByIdAsync(Id);
    }
}
